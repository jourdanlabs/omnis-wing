#!/usr/bin/env bash
# hermes-wing — Path A dogfood / production-cutover launcher.
# Does NOT replace live hermes or modify ~/.hermes/hermes-agent.
set -euo pipefail
ROOT="/Users/sokpyeon/projects/omnis-wing"
VENV_PY="/Users/sokpyeon/.hermes/hermes-agent/venv/bin/python"
PROFILE_HOME="${OMNIS_WING_PROFILE_HOME:-/Users/sokpyeon/.hermes/profiles/videl-wing}"

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
export HERMES_HOME="$PROFILE_HOME"
export OMNIS_WING_WORKSPACE="${OMNIS_WING_WORKSPACE:-$HERMES_HOME/workspace}"

if [[ -z "${OMNIS_WING_SIGNER_MODE:-}" ]]; then
  if [[ -n "${OMNIS_WING_PRODUCTION_CONFIG:-}" ]]; then
    export OMNIS_WING_SIGNER_MODE=production
  else
    export OMNIS_WING_SIGNER_MODE=test
  fi
fi

if [[ -z "${OMNIS_WING_LEDGER_DIR:-}" ]]; then
  if [[ "${OMNIS_WING_SIGNER_MODE}" == "production" ]]; then
    export OMNIS_WING_LEDGER_DIR="${HOME}/.omnis-wing/ledgers/production"
  else
    export OMNIS_WING_LEDGER_DIR="${HOME}/.omnis-wing/ledgers"
  fi
fi

if [[ "${OMNIS_WING_QUIET_BANNER:-}" != "1" ]]; then
  echo "[hermes-wing] HERMES_HOME=$HERMES_HOME" >&2
  echo "[hermes-wing] code=$ROOT" >&2
  echo "[hermes-wing] signer_mode=$OMNIS_WING_SIGNER_MODE" >&2
  echo "[hermes-wing] production_config=${OMNIS_WING_PRODUCTION_CONFIG:-none}" >&2
fi

if [[ ! -x "$VENV_PY" ]]; then
  echo "[hermes-wing] missing venv python: $VENV_PY" >&2
  exit 127
fi
exec "$VENV_PY" -c 'import sys; from hermes_cli.main import main; sys.exit(main())' "$@"
