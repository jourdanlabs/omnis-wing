#!/usr/bin/env bash
# wing — OMNIS WING operator launcher (Track B: sealed soul seats).
# Does NOT replace live hermes. `wing pan` loads MTS-sealed Pan, not Hermes bread.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV_PY="${OMNIS_WING_HERMES_PYTHON:-$HOME/.hermes/hermes-agent/venv/bin/python}"

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

if [[ ! -x "$VENV_PY" ]]; then
  echo "[wing] missing python: $VENV_PY" >&2
  exit 127
fi

exec "$VENV_PY" -m omnis_wing.wing_cli "$@"
