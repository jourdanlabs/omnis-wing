#!/usr/bin/env bash
# wing-dogfood — OMNIS WING dogfood launcher (Path A).
# Does NOT replace live wing or modify ~/.omnis-wing/omnis-wing.
#
# Primary chat goes through local pinned CADUCEUS TERMINUS_REAL_WORK_V1.
# There is no production direct-provider fallback.
set -euo pipefail

# Prefer the worktree / repo that owns this script when present. An installed
# wheel makes omnis_wing available without PYTHONPATH (use OMNIS_WING_VENV_PY).
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
VENV_PY="${OMNIS_WING_VENV_PY:-$HOME/.omnis-wing/omnis-wing/venv/bin/python}"
PROFILE_HOME="${OMNIS_WING_PROFILE_HOME:-$HOME/.omnis-wing/profiles/videl-wing}"

if [[ -d "$ROOT/omnis_wing" ]]; then
  export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
fi
export WING_HOME="$PROFILE_HOME"
export OMNIS_WING_WORKSPACE="${OMNIS_WING_WORKSPACE:-$WING_HOME/workspace}"

if [[ -z "${OMNIS_WING_PRODUCTION_CONFIG:-}" ]]; then
  echo "[wing-dogfood] OMNIS_WING_PRODUCTION_CONFIG is required" >&2
  exit 2
fi
if [[ -z "${OMNIS_WING_REAL_WORK_CONFIG:-}" ]]; then
  echo "[wing-dogfood] OMNIS_WING_REAL_WORK_CONFIG is required" >&2
  exit 2
fi
export OMNIS_WING_SIGNER_MODE=production

preflight() {
  if [[ ! -x "$VENV_PY" ]]; then
    echo "[wing-dogfood] missing venv python: $VENV_PY" >&2
    exit 127
  fi
  # Contract/corpus drift + route honesty
  "$VENV_PY" - <<'PY'
import sys
from omnis_wing.absolute.real_work.admission import admission_manifest, assert_contract_not_drifted
from omnis_wing.absolute.real_work.contract import ROUTE_TABLE, assert_route_honest

assert_contract_not_drifted()
assert_route_honest("wing.chat_join", ROUTE_TABLE["wing.chat_join"])
m = admission_manifest()
print("[wing-dogfood] admission ok base=", m["wing_build_base"][:12], "caduceus_pin=", m["caduceus_proven_pin"][:12], file=sys.stderr)
print("[wing-dogfood] wing.chat_join=", ROUTE_TABLE["wing.chat_join"], file=sys.stderr)
PY

  "$VENV_PY" -m omnis_wing.absolute.real_work.launcher ensure >/dev/null
  "$VENV_PY" -m omnis_wing.absolute.real_work.launcher preflight >/dev/null
}

if [[ "${OMNIS_WING_QUIET_BANNER:-}" != "1" ]]; then
  echo "[wing-dogfood] WING_HOME=$WING_HOME" >&2
  echo "[wing-dogfood] code=$ROOT" >&2
  echo "[wing-dogfood] signer_mode=$OMNIS_WING_SIGNER_MODE" >&2
  echo "[wing-dogfood] production_config=${OMNIS_WING_PRODUCTION_CONFIG:-none}" >&2
  echo "[wing-dogfood] real_work_config=$OMNIS_WING_REAL_WORK_CONFIG" >&2
fi

preflight

exec "$VENV_PY" -c 'import sys; from wing_cli.main import main; sys.exit(main())' "$@"
