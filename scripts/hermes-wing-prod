#!/usr/bin/env bash
# Production-cutover launcher: requires OMNIS_WING_PRODUCTION_CONFIG; never defaults to test signer.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ -z "${OMNIS_WING_PRODUCTION_CONFIG:-}" ]]; then
  echo "Set OMNIS_WING_PRODUCTION_CONFIG to an explicit YAML/JSON config." >&2
  echo "Example: $ROOT/omnis_wing/config/production.example.yaml" >&2
  exit 2
fi
if [[ -z "${OMNIS_WING_REAL_WORK_CONFIG:-}" ]]; then
  echo "Set OMNIS_WING_REAL_WORK_CONFIG to an operator-only real-work config." >&2
  echo "Template: $ROOT/omnis_wing/config/real-work.production.example.json" >&2
  exit 2
fi
export OMNIS_WING_SIGNER_MODE=production
exec "$ROOT/scripts/hermes-wing" "$@"
